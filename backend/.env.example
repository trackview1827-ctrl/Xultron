# Generate production values with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Relative SQLite paths are resolved inside Flask's backend/instance directory.
DATABASE_URL=sqlite:///xultron.sqlite3
XULTRON_ENV=development
SESSION_COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_CONTENT_LENGTH=6291456
MAX_AUDIO_BYTES=5242880
MAX_PROVIDER_RESPONSE_BYTES=1048576
MAX_PROVIDER_TEXT_CHARS=24000
PROVIDER_TIMEOUT_SECONDS=20
# Every provider-backed answer uses a verification plan before the final model call.
# External fact checks use a fixed HTTPS search endpoint and never send queries that
# look like credentials. Set false to fail closed for questions requiring the web.
VERIFICATION_WEB_ENABLED=true
VERIFICATION_TIMEOUT_SECONDS=8

# Local single-user PIN access. Development defaults to user "local-user" with the
# requested four-digit PIN. Production disables this mode unless explicitly enabled.
LOCAL_PIN_LOGIN_ENABLED=true
LOCAL_PIN_USERNAME=local-user
# Optional: override with a Werkzeug password hash, never a plaintext PIN.
LOCAL_PIN_HASH=
